# Copy this file to .env and fill it in.
# Most of the WhatsApp values can also be set from the Start here tab in the UI.

# ---- DATABASE (required) --------------------------------------------------
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SERVICE ROLE key, not the anon/publishable one. It bypasses row-level
# security, so it must never appear in a browser, a git commit, or a chat.
SUPABASE_SERVICE_KEY=

# ---- REQUIRED WHEN HOSTED ONLINE -----------------------------------------
# Login password for the app itself. Without this, anyone who finds your URL
# can read your client list and send messages on your WhatsApp number.
# If you leave it blank, the app asks you to choose a password on first visit
# and stores a hash of it instead — either way, do not run it publicly without one.
APP_PASSWORD=

# Meta app secret (Meta app dashboard > Settings > Basic > App secret).
# When set, incoming webhooks must carry a valid Meta signature or they are
# rejected — stops anyone forging opt-outs or delivery statuses.
WA_APP_SECRET=

# From Meta app dashboard > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=

# Permanent System User token (NOT the 24h temporary one).
# When set here, it is never written to data/db.json — preferred for hosting.
WA_ACCESS_TOKEN=

# Graph API version
WA_API_VERSION=v22.0

# Any random string; you type the same value in the Meta webhook config screen
WA_VERIFY_TOKEN=change-me-to-something-random

# Default country code used when a phone number in your list has no prefix
# e.g. 212 for Morocco, 33 for France, 1 for US/Canada
DEFAULT_COUNTRY_CODE=212

PORT=3000
